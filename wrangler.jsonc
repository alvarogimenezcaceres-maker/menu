// Public menus on Cloudflare Workers (free plan). Static assets are served directly; only POST /e and
// /api/* run site/worker.js: /e writes the anonymous menu events to Analytics Engine, /api/<slug>/… is
// Mesaverso Caja (one SQLite Durable Object per restaurant, site/caja.js). The secret CAJA_SECRET is set
// once in Cloudflare (PUBLICAR.md → «Caja»), never in this file.
// Build first: cd site && SITE_URL=<public url> node build.mjs   → deploy: npx wrangler deploy
{
  "name": "menu3d-demo",
  "main": "site/worker.js",
  "routes": [{ "pattern": "menu.mesaverso.app", "custom_domain": true }],
  // keep the old address alive: QR codes printed before the domain point to it
  "workers_dev": true,
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/e", "/api/*"]
  },
  "triggers": {
    "crons": [
      "0 9 * * *",   // daily   09:00 UTC = 06:00 PY — aggregates yesterday into D1
      "0 10 1 * *"   // monthly 10:00 UTC = 07:00 PY on the 1st — exports prev month D1 → R2
    ]
  },
  "analytics_engine_datasets": [
    { "binding": "MV_EVENTS", "dataset": "mesaverso_menu_events" }
  ],
  "d1_databases": [
    {
      "binding": "MV_D1",
      "database_name": "mesaverso-analytics",
      // Run: npx wrangler d1 create mesaverso-analytics  → paste the id here
      "database_id": "dab6ce03-ff7a-4e1e-b960-25fc8917b197",
      "migrations_dir": "site/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MV_R2",
      "bucket_name": "mesaverso-analytics"
      // Run once: npx wrangler r2 bucket create mesaverso-analytics
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CAJA", "class_name": "Caja" }]
  },
  "migrations": [
    { "tag": "caja-v1", "new_sqlite_classes": ["Caja"] }
  ],
  "observability": { "enabled": true }
}
