// =====================================================================
// 3D Restaurant Menu — Prisma schema (Deliverable #8)
// Mirrors db/schema.sql. Use cases:
//   • Plan B stack (Refine/React-Admin + Hono API) where Prisma owns migrations
//   • Read-side services (analytics, worker status) against the Payload DB
//     → in that case run `prisma db pull` and NEVER `prisma migrate` (Payload owns DDL)
// RLS: wrap queries with `SET LOCAL app.tenant_id` via a Prisma client extension
// (see docs/03-data-model.md §ORM).
// =====================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, pg_trgm, unaccent]
}

enum MemberRole {
  tenant_owner
  tenant_admin
  editor
  viewer

  @@map("member_role")
}

enum PublishStatus {
  draft
  published
  archived

  @@map("publish_status")
}

enum MediaKind {
  image
  capture_photo
  model_glb
  model_usdz
  poster
  other

  @@map("media_kind")
}

enum ModelSource {
  upload
  photogrammetry
  ai_generated

  @@map("model_source")
}

enum ModelStatus {
  pending
  processing
  ready
  failed

  @@map("model_status")
}

enum CaptureStatus {
  uploading
  queued
  processing
  succeeded
  failed
  cancelled

  @@map("capture_status")
}

enum JobType {
  reconstruct
  ai_generate
  optimize
  poster

  @@map("job_type")
}

enum SubStatus {
  trialing
  active
  past_due
  cancelled

  @@map("sub_status")
}

enum Allergen {
  gluten
  crustaceans
  eggs
  fish
  peanuts
  soy
  milk
  nuts
  celery
  mustard
  sesame
  sulphites
  lupin
  molluscs

  @@map("allergen")
}

// ---------------- platform / billing ----------------

model Plan {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique
  name          String
  limits        Json           @default("{}")
  priceMinor    BigInt         @default(0) @map("price_minor")
  currency      String         @default("USD") @db.Char(3)
  isPublic      Boolean        @default(true) @map("is_public")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Tenant {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String            @unique @db.Citext
  planId         String?           @map("plan_id") @db.Uuid
  plan           Plan?             @relation(fields: [planId], references: [id])
  settings       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz
  memberships    Membership[]
  restaurants    Restaurant[]
  media          Media[]
  subscriptions  Subscription[]
  usageCounters  UsageCounter[]
  customDomains  CustomDomain[]
  tables         RestaurantTable[]
  categories     Category[]
  dishes         Dish[]
  dishPhotos     DishPhoto[]
  captures       Capture[]
  capturePhotos  CapturePhoto[]
  models         Model3D[]
  jobs           ProcessingJob[]

  @@map("tenants")
}

model Subscription {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId           String    @map("plan_id") @db.Uuid
  plan             Plan      @relation(fields: [planId], references: [id])
  status           SubStatus @default(trialing)
  provider         String    @default("manual")
  providerRef      String?   @map("provider_ref")
  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@map("subscriptions")
}

model UsageCounter {
  tenantId String   @map("tenant_id") @db.Uuid
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric   String
  period   DateTime @db.Date
  value    BigInt   @default(0)

  @@id([tenantId, metric, period])
  @@map("usage_counters")
}

// ---------------- identity ----------------

model User {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String       @unique @db.Citext
  name            String?
  passwordHash    String?      @map("password_hash")
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  locale          String       @default("es")
  lastLoginAt     DateTime?    @map("last_login_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  memberships     Membership[]
  mediaCreated    Media[]
  captures        Capture[]

  @@map("users")
}

model Membership {
  tenantId  String     @map("tenant_id") @db.Uuid
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(editor)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@id([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------------- media ----------------

model Media {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         MediaKind
  bucket       String
  storageKey   String         @map("storage_key")
  mime         String
  bytes        BigInt
  sha256       String?        @db.Char(64)
  width        Int?
  height       Int?
  alt          String?
  variants     Json           @default("{}")
  createdById  String?        @map("created_by") @db.Uuid
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  logoOf       Restaurant[]   @relation("RestaurantLogo")
  coverOf      Restaurant[]   @relation("RestaurantCover")
  categoryCoverOf Category[]  @relation("CategoryCover")
  dishPhotos   DishPhoto[]
  capturePhoto CapturePhoto[]
  glbOf        Model3D[]      @relation("ModelGlb")
  usdzOf       Model3D[]      @relation("ModelUsdz")
  posterOf     Model3D[]      @relation("ModelPoster")

  @@unique([bucket, storageKey])
  @@index([tenantId, kind])
  @@map("media")
}

// ---------------- restaurants / menu ----------------

model Restaurant {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  slug          String            @unique @db.Citext
  description   String?
  logoId        String?           @map("logo_id") @db.Uuid
  logo          Media?            @relation("RestaurantLogo", fields: [logoId], references: [id], onDelete: SetNull)
  coverId       String?           @map("cover_id") @db.Uuid
  cover         Media?            @relation("RestaurantCover", fields: [coverId], references: [id], onDelete: SetNull)
  currency      String            @default("USD") @db.Char(3)
  defaultLocale String            @default("es") @map("default_locale")
  locales       String[]          @default(["es"])
  theme         Json              @default("{}")
  contact       Json              @default("{}")
  seo           Json              @default("{}")
  status        PublishStatus     @default(draft)
  publishedAt   DateTime?         @map("published_at") @db.Timestamptz
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz
  domains       CustomDomain[]
  tables        RestaurantTable[]
  categories    Category[]
  dishes        Dish[]

  @@index([tenantId])
  @@map("restaurants")
}

model CustomDomain {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId      String     @map("restaurant_id") @db.Uuid
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  hostname          String     @unique @db.Citext
  verificationToken String     @default(dbgenerated("encode(gen_random_bytes(16), 'hex')")) @map("verification_token")
  verifiedAt        DateTime?  @map("verified_at") @db.Timestamptz
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@map("custom_domains")
}

model RestaurantTable {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId String     @map("restaurant_id") @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  code         String
  sigSecret    String     @default(dbgenerated("encode(gen_random_bytes(16), 'hex')")) @map("sig_secret")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@unique([restaurantId, code])
  @@map("restaurant_tables")
}

model Category {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId  String     @map("restaurant_id") @db.Uuid
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  slug          String     @db.Citext
  description   String?
  coverId       String?    @map("cover_id") @db.Uuid
  cover         Media?     @relation("CategoryCover", fields: [coverId], references: [id], onDelete: SetNull)
  i18n          Json       @default("{}")
  position      Int        @default(0)
  isVisible     Boolean    @default(true) @map("is_visible")
  availableFrom DateTime?  @map("available_from") @db.Time
  availableTo   DateTime?  @map("available_to") @db.Time
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  dishes        Dish[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, position])
  @@map("categories")
}

model Dish {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurantId    String                   @map("restaurant_id") @db.Uuid
  restaurant      Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String?                  @map("category_id") @db.Uuid
  category        Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  slug            String                   @db.Citext
  description     String?
  ingredients     String[]                 @default([])
  allergens       Allergen[]               @default([])
  tags            String[]                 @default([])
  priceMinor      BigInt?                  @map("price_minor")
  options         Json                     @default("[]")
  compareAtMinor  BigInt?                  @map("compare_at_minor")
  i18n            Json                     @default("{}")
  plateDiameterCm Decimal?                 @default(27.0) @map("plate_diameter_cm") @db.Decimal(5, 1)
  activeModelId   String?                  @unique @map("active_model_id") @db.Uuid
  activeModel     Model3D?                 @relation("DishActiveModel", fields: [activeModelId], references: [id], onDelete: SetNull)
  position        Int                      @default(0)
  isAvailable     Boolean                  @default(true) @map("is_available")
  status          PublishStatus            @default(draft)
  search          Unsupported("tsvector")?
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz
  photos          DishPhoto[]
  captures        Capture[]
  models          Model3D[]                @relation("DishModels")

  @@unique([restaurantId, slug])
  @@index([restaurantId, categoryId, position])
  @@map("dishes")
}

model DishPhoto {
  dishId   String @map("dish_id") @db.Uuid
  dish     Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  mediaId  String @map("media_id") @db.Uuid
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  position Int    @default(0)

  @@id([dishId, mediaId])
  @@map("dish_photos")
}

// ---------------- 3D pipeline ----------------

model Capture {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dishId      String          @map("dish_id") @db.Uuid
  dish        Dish            @relation(fields: [dishId], references: [id], onDelete: Cascade)
  status      CaptureStatus   @default(uploading)
  photoCount  Int             @default(0) @map("photo_count")
  options     Json            @default("{}")
  createdById String?         @map("created_by") @db.Uuid
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  photos      CapturePhoto[]
  models      Model3D[]
  jobs        ProcessingJob[]

  @@index([dishId])
  @@map("captures")
}

model CapturePhoto {
  captureId String  @map("capture_id") @db.Uuid
  capture   Capture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  mediaId   String  @map("media_id") @db.Uuid
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tenantId  String  @map("tenant_id") @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seq       Int

  @@id([captureId, mediaId])
  @@map("capture_photos")
}

model Model3D {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dishId      String          @map("dish_id") @db.Uuid
  dish        Dish            @relation("DishModels", fields: [dishId], references: [id], onDelete: Cascade)
  captureId   String?         @map("capture_id") @db.Uuid
  capture     Capture?        @relation(fields: [captureId], references: [id], onDelete: SetNull)
  version     Int             @default(1)
  source      ModelSource
  status      ModelStatus     @default(pending)
  glbId       String?         @map("glb_id") @db.Uuid
  glb         Media?          @relation("ModelGlb", fields: [glbId], references: [id], onDelete: SetNull)
  usdzId      String?         @map("usdz_id") @db.Uuid
  usdz        Media?          @relation("ModelUsdz", fields: [usdzId], references: [id], onDelete: SetNull)
  posterId    String?         @map("poster_id") @db.Uuid
  poster      Media?          @relation("ModelPoster", fields: [posterId], references: [id], onDelete: SetNull)
  triangles   Int?
  glbBytes    BigInt?         @map("glb_bytes")
  bboxM       Json?           @map("bbox_m")
  viewerOpts  Json            @default("{}") @map("viewer_opts")
  validation  Json?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  activeFor   Dish?           @relation("DishActiveModel")
  jobs        ProcessingJob[]

  @@unique([dishId, version])
  @@map("models_3d")
}

model ProcessingJob {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       JobType
  captureId  String?   @map("capture_id") @db.Uuid
  capture    Capture?  @relation(fields: [captureId], references: [id], onDelete: Cascade)
  modelId    String?   @map("model_id") @db.Uuid
  model      Model3D?  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  bossJobId  String?   @map("boss_job_id") @db.Uuid
  stage      String?
  progress   Int       @default(0) @db.SmallInt
  attempts   Int       @default(0) @db.SmallInt
  error      String?
  gpuSeconds Int?      @map("gpu_seconds")
  startedAt  DateTime? @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("processing_jobs")
}

// ---------------- analytics / audit ----------------
// menu_events is range-partitioned in SQL; Prisma sees the parent table.

model MenuEvent {
  id           BigInt   @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  dishId       String?  @map("dish_id") @db.Uuid
  tableCode    String?  @map("table_code")
  event        String
  sessionHash  String?  @map("session_hash")
  uaClass      String?  @map("ua_class")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([restaurantId, createdAt])
  @@map("menu_events")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  diff      Json?
  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
