// Mesaverso landing v2 («La noche sin papelitos»): preview only. Same Worker code and KV as the live landing, but it
// serves dist-v2/. Run it locally with:   npm run dev:v2   (builds dist-v2/ and starts wrangler on port 8789)
// DO NOT deploy this file by accident: the Worker name below is a separate preview Worker, not the live one. To promote
// v2, follow the steps in plan/landing-2026/ita.md (owner's OK first).
{
  "name": "mesaverso-landing-v2-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-v2",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "LEADS", "id": "70aea932f1d24c649e1e70273901a996" }
  ],
  "observability": { "enabled": true }
}
