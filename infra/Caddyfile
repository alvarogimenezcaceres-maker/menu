{
	email {$ACME_EMAIL}
	# Custom domains: issue certs only for hostnames the app has verified
	on_demand_tls {
		ask http://web:3000/api/domains/verify
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), xr-spatial-tracking=(self)"
	}

	# Immutable public assets straight from S3 (never hits Node)
	handle_path /media/* {
		rewrite * /media-public{uri}
		reverse_proxy seaweedfs:8333
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin *
	}
	handle_path /models/* {
		rewrite * /models-public{uri}
		reverse_proxy seaweedfs:8333
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin *
		@usdz path *.usdz
		header @usdz Content-Type model/vnd.usdz+zip
		@glb path *.glb
		header @glb Content-Type model/gltf-binary
	}

	# Internal worker API is never exposed publicly
	@internal path /api/internal/*
	respond @internal 404

	handle {
		reverse_proxy web:3000
	}
}

# Platform domain: menu.domain.com/{slug} + admin
{$ROOT_DOMAIN} {
	import common
}

# Phase 2 subdomains ({slug}.menu.domain.com) need a DNS-01 wildcard cert:
# *.{$ROOT_DOMAIN} {
# 	tls { dns <provider> {env.DNS_API_TOKEN} }
# 	import common
# }

# Everything else = tenant custom domains (verified via the ask endpoint)
https:// {
	tls {
		on_demand
	}
	import common
}
